# ──────────────────────────────────────────────────────────────────────────────
# Names only — copy to .env locally; set these in Railway / Vercel for deploys.
# Never commit real values.
# ──────────────────────────────────────────────────────────────────────────────

# ── BACKEND (Railway) ─────────────────────────────────────────────────────────
NODE_ENV=production
SERVE_CLIENT=false                      # API-only: the frontend is on Vercel
DATABASE_URL=                           # mysql://user:pass@host:4000/db?ssl={"minVersion":"TLSv1.2","rejectUnauthorized":true}
JWT_SECRET=                             # decrypts saved distributor API keys + SMTP password — must not change
SUPABASE_URL=                           # https://<project>.supabase.co
SUPABASE_JWT_SECRET=                    # Supabase → Project Settings → JWT Keys → Legacy JWT secret
SUPABASE_SERVICE_ROLE_KEY=              # server only — never put in a VITE_ variable
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=                    # server-side Geocoding API only
ELEVENLABS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OWNER_EMAIL=
OWNER_OPEN_ID=
CRM_WEBHOOK_URL=
CORS_ALLOWED_ORIGINS=https://www.cabinetdealz.com,https://*.cabinetdealz.com   # add the *.vercel.app preview URL if used
FRONTEND_SHELL_URL=https://www.cabinetdealz.com/index.html                     # where the built index.html is served
# Optional: AUTHORIZE_NET_API_LOGIN_ID, AUTHORIZE_NET_TRANSACTION_KEY, QBO_CLIENT_ID, QBO_CLIENT_SECRET,
#           QBO_ENVIRONMENT, QBO_REDIRECT_URI, TWILIO_API_KEY, TWILIO_API_SECRET, TWILIO_VERIFY_SERVICE_SID

# ── FRONTEND (Vercel, build-time) ─────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=https://api.cabinetdealz.com   # tRPC goes straight to the API host; empty = same origin
VITE_AFFILIATE_DNS_TARGET=cname.vercel-dns.com   # shown in the admin DNS instructions
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=

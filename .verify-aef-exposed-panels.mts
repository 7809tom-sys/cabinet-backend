import mysql from 'mysql2/promise';
const db=await mysql.createConnection(process.env.DATABASE_URL!);
const codes=['BEP2535','WEP1523','WEP1530','WEP1535','WEP1542'];
const [rows]=await db.query(`SELECT d.code distributor,c.masterCode,c.description,c.category,c.subCategory,c.width masterWidth,c.height masterHeight,c.depth masterDepth,c.placementType,c.isNotCabinet,c.showInCatalog,c.showInDesigner,ds.distributorSku,st.styleCode,ds.listPrice,ds.yourCost,ds.homeownerPrice,ds.isPublished,ds.isAvailable,ds.constructionType,ds.geometryWidth,ds.geometryHeight,ds.geometryDepth,ds.geometrySourcePage,ds.imageUrl,ds.supplierDescription FROM distributor_skus ds JOIN cabinets c ON c.id=ds.cabinetId JOIN distributors d ON d.id=ds.distributorId JOIN door_styles st ON st.id=ds.styleId WHERE c.masterCode IN (${codes.map(()=>'?').join(',')}) ORDER BY c.masterCode,d.code,st.styleCode`,codes);
const grouped:any={}; for(const r of rows as any[]){ const key=`${r.distributor}:${r.masterCode}`; (grouped[key]??=[]).push(r); }
const summary=Object.fromEntries(Object.entries(grouped).map(([key,all]:any)=>[key,{count:all.length,master:{description:all[0].description,category:all[0].category,subCategory:all[0].subCategory,masterGeometry:[all[0].masterWidth,all[0].masterHeight,all[0].masterDepth],placementType:all[0].placementType,isNotCabinet:all[0].isNotCabinet,showInCatalog:all[0].showInCatalog,showInDesigner:all[0].showInDesigner},aef:all.filter((r:any)=>r.distributor==='AEF').map((r:any)=>({style:r.styleCode,list:r.listPrice,cost:r.yourCost,homeowner:r.homeownerPrice,published:r.isPublished,available:r.isAvailable,construction:r.constructionType,geometry:[r.geometryWidth,r.geometryHeight,r.geometryDepth],source:r.geometrySourcePage,image:r.imageUrl,description:r.supplierDescription}))}]));
console.log(JSON.stringify({summary},null,2)); await db.end();
